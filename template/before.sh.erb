# rstudio 1.4+ needs a csrf token
export csrf_token=<%= SecureRandom.uuid %>

# Export env prereqs for rstudio config
export port=$(find_port ${host})
export password="$(create_passwd 16)"
export RSTUDIO_PORT=$port
export RSTUDIO_PASSWORD="$password"
export RSTUDIO_CONFIG_DIR="$HOME/.config/rstudio-server"
export RSTUDIO_DATA_DIR="$HOME/.cache/rstudio-server"
export RSTUDIO_SHARE_DIR="$HOME/.local/share/rstudio"
export DB_CONF_FILE="$RSTUDIO_CONFIG_DIR/rstudio-database.conf"
export RSERVER_CONF="$PWD/rserver.conf"
export RSESSION_CONF="$PWD/rsession.conf"
export RSESSION_WRAPPER_FILE="$PWD/rsession.sh"
export RSTUDIO_AUTH="$PWD/bin/auth"
export RSTUDIO_COOKIE_FILE="$RSTUDIO_DATA_DIR/secure-cookie-key"
# Create cookie
python3 -c 'from uuid import uuid4; print(uuid4())' > "$RSTUDIO_COOKIE_FILE"
chmod 0600 "$RSTUDIO_COOKIE_FILE"

<% if context.fresh_start %>
mv -f $RSTUDIO_SHARE_DIR{,.bak}
<% end %>
